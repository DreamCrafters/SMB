# Справочник для окружения PRODUCTION (smb.aonmou.ru).
# На сервере это ДВА отдельных файла в ДВУХ разных папках — ниже они
# разделены комментариями-заголовками с точным путём назначения.
# Просто скопируйте соответствующий блок в указанный файл (без строк-заголовков).

# ============================================================
# → ~/domains/smb.aonmou.ru/app/.env.production
#   (фронтенд, Vite; шаблон: /.env.production.example)
# ============================================================
VITE_SMB_APP_ENV=production
VITE_SMB_REMOTE_API_URL=https://smb.aonmou.ru

# ============================================================
# → ~/domains/smb.aonmou.ru/app/server/.env
#   ВНИМАНИЕ: имя файла на сервере — просто ".env", БЕЗ суффикса ".production"!
#   Это отдельный файл от server/.env теста — они лежат в разных папках.
#   (бэкенд; шаблон: /server/.env.production.example)
# ============================================================
SMB_APP_ENV=production
PORT=3000
# ⚠ "prod_database" — placeholder, а не реальное имя (по аналогии с тестом,
# где "test_database" оказался недействительным). Уточните точное имя базы
# и права пользователя j53403317_smb в панели Jino ДО первого запуска.
DATABASE_URL=mysql://j53403317_smb:ZondArt2002@localhost:3306/prod_database
CORS_ORIGIN=https://smb.aonmou.ru
RUN_MIGRATIONS_ON_START=false
DEV_ACCESS_ENABLED=false
SESSION_COOKIE_NAME=smb_session
SESSION_TTL_HOURS=12

GOOGLE_SHEETS_AUTH=service_account
GOOGLE_SHEETS_REFERENCE_URL=https://docs.google.com/spreadsheets/d/1JYz_03AW4j9VXNfdNSBFfdFyxq0Dun_0QnYGvVesGyg/edit?gid=0#gid=0
# ⚠ Файл ключа сервис-аккаунта должен реально существовать на сервере по этому пути.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=/home/users/j/j53403317/domains/smb.aonmou.ru/private/google-service-account.json
GOOGLE_SHEETS_CACHE_TTL_MS=300000

EMAIL_NOTIFICATIONS_ENABLED=false
EMAIL_FROM=smb-sheets-reader@smb-monitor-sheets.iam.gserviceaccount.com
EMAIL_SUBJECT_PREFIX=SMB Monitor
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

MAX_NOTIFICATIONS_ENABLED=false
MAX_BOT_TOKEN=
MAX_API_BASE_URL=https://platform-api2.max.ru
MAX_RECIPIENT_ID_TYPE=user_id
MAX_SUBJECT_PREFIX=SMB Monitor
MAX_CA_CERT_FILE=
