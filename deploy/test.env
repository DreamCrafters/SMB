# Справочник для окружения TEST (test.smb.aonmou.ru).
# На сервере это ДВА отдельных файла в ДВУХ разных папках — ниже они
# разделены комментариями-заголовками с точным путём назначения.
# Просто скопируйте соответствующий блок в указанный файл (без строк-заголовков).

# ============================================================
# → ~/domains/test.smb.aonmou.ru/app/.env.test
#   (фронтенд, Vite; шаблон: /.env.test.example)
# ============================================================
VITE_SMB_APP_ENV=test
VITE_SMB_REMOTE_API_URL=https://test.smb.aonmou.ru

# ============================================================
# → ~/domains/test.smb.aonmou.ru/app/server/.env
#   ВНИМАНИЕ: имя файла на сервере — просто ".env", БЕЗ суффикса ".test"!
#   (бэкенд; шаблон: /server/.env.test.example)
# ============================================================
SMB_APP_ENV=test
PORT=3000
# ⚠ Проверено на практике: "test_database" — placeholder, а не реальное имя.
# На Jino имена БД обычно с префиксом логина, например j53403317_test_database.
# Уточните точное имя и права пользователя j53403317_test в панели Jino.
DATABASE_URL=mysql://j53403317_test:ZondArt2002@localhost:3306/test_database
CORS_ORIGIN=https://test.smb.aonmou.ru
RUN_MIGRATIONS_ON_START=false
DEV_ACCESS_ENABLED=true
SESSION_COOKIE_NAME=smb_test_session
SESSION_TTL_HOURS=12

GOOGLE_SHEETS_AUTH=service_account
GOOGLE_SHEETS_REFERENCE_URL=https://docs.google.com/spreadsheets/d/1JYz_03AW4j9VXNfdNSBFfdFyxq0Dun_0QnYGvVesGyg/edit?gid=981703922#gid=981703922
# ⚠ Файл ключа сервис-аккаунта должен реально существовать на сервере по этому пути.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=/home/users/j/j53403317/domains/test.smb.aonmou.ru/private/google-service-account.json
GOOGLE_SHEETS_CACHE_TTL_MS=300000

EMAIL_NOTIFICATIONS_ENABLED=false
EMAIL_FROM=
EMAIL_SUBJECT_PREFIX=SMB Monitor Test
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

MAX_NOTIFICATIONS_ENABLED=false
MAX_BOT_TOKEN=
MAX_API_BASE_URL=https://platform-api2.max.ru
MAX_RECIPIENT_ID_TYPE=user_id
MAX_SUBJECT_PREFIX=SMB Monitor Test
MAX_CA_CERT_FILE=
