{
  "name": "@smb-monitor/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/**/*.test.js",
    "test:jino": "npm run build && node --test --test-concurrency=1 dist/**/*.test.js",
    "db:migrate": "tsx src/db/migrate.ts",
    "auth:create-user": "tsx src/db/createAuthUser.ts"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "mysql2": "^3.22.5",
    "nodemailer": "^9.0.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.25",
    "@types/nodemailer": "^8.0.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
